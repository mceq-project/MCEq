# Import layering of MCEq. Run: PYTHONPATH=src lint-imports

[importlinter]
root_packages =
    MCEq
    mceq_config

[importlinter:contract:layers]
name = core -> batch -> solvers -> operators -> particlemanager -> data -> misc -> config
type = layers
containers =
    MCEq
layers =
    core
    batch
    solvers
    operators
    particlemanager
    initial_state
    bin_average | data
    misc
    config

[importlinter:contract:environment]
name = geometry does not import the cascade stack
type = forbidden
source_modules =
    MCEq.geometry
forbidden_modules =
    MCEq.core
    MCEq.batch
    MCEq.initial_state
    MCEq.solvers
    MCEq.operators
    MCEq.particlemanager
    MCEq.data

[importlinter:contract:legacy]
name = nothing imports the legacy mceq_config module
type = forbidden
source_modules =
    MCEq
forbidden_modules =
    mceq_config
