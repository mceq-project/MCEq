# Import layering of MCEq. Run: PYTHONPATH=src lint-imports

[importlinter]
root_packages =
    MCEq
    mceq_config

[importlinter:contract:layers]
name = core -> driver -> solvers -> operators -> species -> data -> misc -> config
type = layers
containers =
    MCEq
layers =
    core
    driver
    solvers
    operators
    species
    data
    misc
    config
    mkl_runtime
ignore_imports =
    MCEq.misc -> MCEq.data.*

[importlinter:contract:environment]
name = environment does not import the cascade stack
type = forbidden
source_modules =
    MCEq.environment
forbidden_modules =
    MCEq.core
    MCEq.driver
    MCEq.solvers
    MCEq.operators
    MCEq.species
    MCEq.data
ignore_imports =
    MCEq.misc -> MCEq.data.*

[importlinter:contract:legacy]
name = nothing imports the legacy mceq_config module
type = forbidden
source_modules =
    MCEq
forbidden_modules =
    mceq_config
